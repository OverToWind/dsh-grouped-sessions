{
  "name": "dsh-grouped-sessions",
  "version": "1.1.0",
  "description": "Turn the DSH sidebar into a workspace → group → session tree: file sessions into groups, reorder the groups you use most to the top, and open a session from its row.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OverToWind/dsh-grouped-sessions.git"
  },
  "homepage": "https://github.com/OverToWind/dsh-grouped-sessions#readme",
  "bugs": {
    "url": "https://github.com/OverToWind/dsh-grouped-sessions/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "sidebar",
    "session-groups"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
